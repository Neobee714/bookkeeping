# ---------------------------------------------------------------------------
# 金流（bookkeeping）v0.6 —— 推送即自动部署 · 配置模板
#
# 用法：install.sh 首次运行时把本文件复制为 /opt/bookkeeping/ci/ci.env
#       （复制后本文件不再被读取；改配置请改 ci.env 并重新运行 install.sh 以刷新 timer）
# 格式：纯 KEY=VALUE 的 shell 变量赋值（会被 deploy.sh `source`，不要写命令/反引号）
# ---------------------------------------------------------------------------

# 只部署这个分支（其它分支一律忽略，包括 codex/*）
BRANCH=main

# 仓库地址：公开仓库，匿名 HTTPS 拉取，服务器上不需要任何 Git 凭据
REPO_URL=https://github.com/Neobee714/bookkeeping.git

# 服务器上的 git 工作副本（只读镜像语义：每轮 reset --hard 到 origin/<BRANCH>）
REPO_DIR=/opt/bookkeeping/repo

# 状态目录：last-deployed.txt / failed-sha.txt / ALERT.txt / deploy.lock
STATE_DIR=/opt/bookkeeping/ci/state

# compose 运行目录（含 docker-compose.yml、.env、nginx.conf）；backend/ 是部署产物目录
STACK_DIR=/opt/bookkeeping/stack

# 前端源码目录（node_modules 保留在此，rsync 不会删）
FRONTEND_SRC=/opt/bookkeeping/frontend

# 前端静态发布目录（nginx 提供服务，产物归 www-data）
FRONTEND_PUBLISH=/var/www/frontend

# 烘焙进前端产物的 API 域（vite 构建时写入 VITE_API_URL=https://$PUBLIC_HOST/api）
# 现网实测值：api.bookkeeping.neobee.top
PUBLIC_HOST=api.bookkeeping.neobee.top

# 数据库快照目录（迁移前自动快照；基线 dump 不参与清理）
DUMP_DIR=/opt/bookkeeping/dumps

# 迁移前快照保留份数（只清理 pre-deploy_* 前缀，绝不碰基线 dump）
KEEP_DUMPS=5

# 部署日志文件（systemd 单元的 StandardOutput/StandardError=append: 也指向它）
LOG_FILE=/var/log/bk-deploy.log

# 后端探活地址（docker 映射到宿主 127.0.0.1:18080）
HEALTH_URL=http://127.0.0.1:18080/health

# 轮询周期（systemd timer 的 OnUnitActiveSec；install.sh 渲染进 bk-deploy.timer）
# 支持 systemd 时间单位：90s / 2min / 1h（最小 30s，太短没有意义）
POLL_INTERVAL=2min
